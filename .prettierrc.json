{
  "printWidth": 100,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "none",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["vitrine-frontend/**/*.{js,jsx,css}", "*.json", "*.md"],
      "options": { "tabWidth": 2 }
    }
  ]
}
