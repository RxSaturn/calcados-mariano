# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env não é versionado.

# Porta HTTP do backend.
# Padrão: 3000
PORT=3000

# Caminho do arquivo do banco SQLite.
# Padrão: calcados_mariano.db na raiz do projeto.
# Os testes apontam esta variável para um arquivo temporário.
DB_PATH=./calcados_mariano.db

# Origens que o CORS aceita, separadas por vírgula.
# Deixe vazio para aceitar qualquer origem, o que serve só para desenvolvimento.
# Em produção, liste as origens do painel de estoque.
CORS_ORIGINS=http://localhost:5173
