{
  "name": "calcados-mariano",
  "version": "1.0.0",
  "description": "API de gestão de estoque da Calçados Mariano, loja de calçados de Bambuí (MG).",
  "main": "server.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "instalar": "node scripts/instalar.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node db/setup.js",
    "backup": "node scripts/backup.js",
    "auth:hash": "node db/hash-senha.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "estoque",
    "calcados",
    "express",
    "sqlite",
    "api-rest"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RxSaturn/calcados-mariano.git"
  },
  "bugs": {
    "url": "https://github.com/RxSaturn/calcados-mariano/issues"
  },
  "homepage": "https://github.com/RxSaturn/calcados-mariano#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
