# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env não é versionado.

# URL base da API de estoque.
# Deixe vazio em desenvolvimento: o proxy do vite.config.js encaminha para a porta 3000.
VITE_API_URL=

# Quantidade a partir da qual o estoque conta como baixo.
# Padrão: 10
VITE_ESTOQUE_BAIXO=10
